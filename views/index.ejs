<!DOCTYPE html>
<html>
<head>
  <title>Book Notes</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#6366f1"
          }
        }
      },
      plugins: [tailwindcssLineClamp]
    }
  </script>
</head>

<body class="bg-[#020617] text-white">

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-12">

  <!-- HEADER -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-6 mb-12">

    <div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-[1.1]">
        <span class="bg-gradient-to-r from-white via-gray-300 to-gray-500 bg-clip-text text-transparent">
          Book Notes
        </span>
      </h1>

      <p class="text-gray-500 mt-3 text-sm max-w-lg">
        Capture insights, highlights, and ideas from every book you read.
      </p>
    </div>

    <a href="/add"
       class="w-full sm:w-auto text-center bg-primary hover:bg-indigo-500 px-6 py-3 rounded-xl shadow-lg hover:shadow-indigo-500/20 transition text-sm font-medium">
       + Add Book
    </a>

  </div>

  <!-- 🔥 LIVE SEARCH -->
  <div class="mb-10">
    <div class="relative w-full sm:max-w-xl">

      <div class="absolute inset-0 bg-indigo-500/20 blur-2xl opacity-30 rounded-xl"></div>

      <input
        id="searchInput"
        type="text"
        placeholder="Search your books, notes, or authors..."
        class="relative w-full bg-white/[0.04] border border-white/10 backdrop-blur-xl text-white placeholder-gray-500 px-5 py-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
      >

    </div>
  </div>

  <!-- DIVIDER -->
  <div class="h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent mb-10"></div>

  <!-- SORT -->
  <div class="flex flex-wrap gap-4 sm:gap-6 mb-10 text-sm text-gray-400">
    <a href="/?sort=date" class="hover:text-white transition">Sort by Date</a>
    <a href="/?sort=rating" class="hover:text-white transition">Sort by Rating</a>
    <a href="/?sort=title" class="hover:text-white transition">Sort by Title</a>
  </div>

  <% if (books.length === 0) { %>

    <div class="text-center mt-32 sm:mt-40">
      <p class="text-xl sm:text-2xl text-gray-300">No books yet</p>
      <p class="text-gray-500 text-sm mt-2">
        Start building your personal reading library
      </p>

      <a href="/add"
         class="inline-block mt-6 bg-primary px-6 py-2.5 rounded-lg hover:bg-indigo-500 transition">
         Add First Book
      </a>
    </div>

  <% } else { %>

  <!-- GRID -->
  <div id="booksGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-10">

    <% books.forEach(book => { %>

    <div 
      class="book-card group relative bg-white/[0.04] backdrop-blur-2xl border border-white/10 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl hover:shadow-indigo-500/10 hover:-translate-y-1 transition duration-300 flex flex-col"
      data-title="<%= book.title.toLowerCase() %>"
      data-author="<%= (book.author || '').toLowerCase() %>"
      data-notes="<%= (book.notes || '').toLowerCase() %>"
    >

      <!-- CLICKABLE -->
      <a href="/book/<%= book.id %>" class="absolute inset-0 z-10"></a>

      <!-- GLOW -->
      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition pointer-events-none">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-72 h-72 bg-indigo-500/10 blur-3xl"></div>
      </div>

      <!-- COVER -->
      <div class="h-56 sm:h-64 bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center">
        <% if (book.cover_id) { %>
          <img 
            src="https://covers.openlibrary.org/b/id/<%= book.cover_id %>-L.jpg"
            class="h-full object-contain group-hover:scale-105 transition duration-300"
          >
        <% } else { %>
          <span class="text-gray-600 text-sm">No Cover</span>
        <% } %>
      </div>

      <!-- CONTENT -->
      <div class="p-5 sm:p-6 flex flex-col flex-grow">

        <h2 class="text-base sm:text-lg font-semibold"><%= book.title %></h2>

        <p class="text-gray-400 text-sm mt-1">
          <%= book.author || "Unknown Author" %>
        </p>

        <!-- ⭐ PREMIUM RATING -->
        <div class="flex items-center justify-between mt-4 text-sm">

          <div class="flex items-center gap-1 text-yellow-400">
            <% const rating = Number(book.rating) || 0; %>

            <% for (let i = 1; i <= 5; i++) { %>
              <% if (i <= rating) { %>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M10 15l-5.878 3.09L5.5 12.545.999 8.41l6.06-.88L10 2l2.94 5.53 6.06.88-4.501 4.136 1.378 5.545z"/>
                </svg>
              <% } else { %>
                <svg class="w-4 h-4 text-gray-600" viewBox="0 0 20 20">
                  <path d="M10 15l-5.878 3.09L5.5 12.545.999 8.41l6.06-.88L10 2l2.94 5.53 6.06.88-4.501 4.136 1.378 5.545z"/>
                </svg>
              <% } %>
            <% } %>

            <span class="ml-2 text-xs text-gray-400">
              <%= rating > 0 ? rating + "/5" : "" %>
            </span>
          </div>

          <span class="text-gray-500 text-xs">
            <%= book.date_read 
              ? new Date(book.date_read).toLocaleDateString('en-CA') 
              : "No date" %>
          </span>

        </div>

        <!-- NOTES -->
        <p class="mt-4 text-sm text-gray-300 line-clamp-4 px-4 py-3 border border-white/5 rounded-lg bg-white/[0.03]">
          <%= book.notes || "No notes added yet." %>
        </p>

        <!-- ACTIONS -->
        <div class="mt-auto pt-6 flex justify-between text-sm relative z-20">
          <a href="/edit/<%= book.id %>" class="text-blue-400 hover:text-blue-300">Edit</a>

          <form action="/delete/<%= book.id %>" method="POST">
            <button class="text-red-400 hover:text-red-300">Delete</button>
          </form>
        </div>

      </div>

    </div>

    <% }) %>

  </div>

  <% } %>

</div>

<!-- 🔥 LIVE SEARCH SCRIPT -->
<script>
  const input = document.getElementById("searchInput");
  const cards = document.querySelectorAll(".book-card");

  input.addEventListener("input", () => {
    const value = input.value.toLowerCase();

    cards.forEach(card => {
      const title = card.dataset.title;
      const author = card.dataset.author;
      const notes = card.dataset.notes;

      if (
        title.includes(value) ||
        author.includes(value) ||
        notes.includes(value)
      ) {
        card.style.display = "flex";
      } else {
        card.style.display = "none";
      }
    });
  });
</script>

</body>
</html>